# Développement local : ne pas exposer directement le port à Internet.
HOST=127.0.0.1
PORT=8787
BERKIOS_DB=./berkios-users.sqlite
# Liste des origines du Studio, séparées par des virgules. Exemple : https://studio.example.com
BERKIOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Générer un secret long aléatoire et le garder uniquement dans l'environnement serveur.
BERKIOS_SUPER_ADMIN_TOKEN=replace-with-a-long-random-secret

# Bridge production integration
BERKIOS_ACCOUNT_ENFORCEMENT=1
BERKIOS_ACCOUNT_API_URL=https://accounts.example.com

# Licences hors ligne signées Ed25519 (générer une fois avec npm run keys:generate).
# Ne jamais copier la clé privée sur les postes utilisateurs.
BERKIOS_LICENSE_PRIVATE_KEY_FILE=./secrets/license-ed25519-private.pem
BERKIOS_LICENSE_PUBLIC_KEY_FILE=./secrets/license-ed25519-public.pem

# Rappels d’expiration par webhook HTTP (désactivé si URL absente).
# Le fournisseur doit accepter un POST JSON {to, subject, text, template, ...} et répondre en 2xx.
# En production, utiliser obligatoirement HTTPS. Le jeton reste uniquement sur le serveur.
BERKIOS_NOTIFICATION_API_URL=
BERKIOS_NOTIFICATION_API_TOKEN=
